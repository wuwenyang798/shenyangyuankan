---
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/TagList.astro';
import { articleUrl } from '../utils/getAllArticles';
const { article, related = [] } = Astro.props;
const { Content } = await article.render();
---
<BaseLayout title={`${article.data.title} | 深洋远瞰`} description={article.data.description} canonical={Astro.url.href}>
  <article class="mx-auto max-w-4xl px-5 py-12">
    <a class="text-sm text-cyan" href={`/${article.collection}/`}>← 返回栏目</a>
    <header class="mt-6 rounded-3xl border border-line bg-panel/70 p-8">
      <p class="text-sm text-muted">{article.data.category} · {article.data.date.toLocaleDateString('zh-CN')}</p>
      <h1 class="mt-4 text-3xl font-bold md:text-5xl">{article.data.title}</h1>
      <p class="mt-4 text-lg leading-8 text-slate-300">{article.data.description}</p>
      <div class="mt-5"><TagList tags={article.data.tags} /></div>
    </header>
    <div class="prose mt-10 max-w-none">
      <Content />
    </div>
    {related.length > 0 && <section class="mt-14">
      <h2 class="text-2xl font-bold">相关文章推荐</h2>
      <div class="mt-5 grid gap-4 md:grid-cols-2">
        {related.map((item:any) => <a class="rounded-2xl border border-line bg-panel/60 p-5 hover:border-brand" href={articleUrl(item)}>
          <p class="text-sm text-muted">{item.data.category}</p><h3 class="mt-2 font-bold">{item.data.title}</h3><p class="mt-2 text-sm text-muted">{item.data.description}</p>
        </a>)}
      </div>
    </section>}
  </article>
</BaseLayout>
