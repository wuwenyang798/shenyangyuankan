---
import TagList from './TagList.astro';
import { articleUrl } from '../utils/getAllArticles';
const { article } = Astro.props;
---
<article class="group rounded-3xl border border-line bg-panel/70 p-6 transition hover:-translate-y-1 hover:border-brand">
  <p class="text-sm text-muted">{article.data.category} · {article.data.date.toLocaleDateString('zh-CN')}</p>
  <h3 class="mt-3 text-xl font-bold group-hover:text-cyan"><a href={articleUrl(article)}>{article.data.title}</a></h3>
  <p class="mt-3 line-clamp-3 text-sm leading-7 text-slate-300">{article.data.description}</p>
  <div class="mt-5"><TagList tags={article.data.tags} /></div>
</article>
