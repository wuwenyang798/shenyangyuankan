---
import BaseLayout from '../layouts/BaseLayout.astro';
import PriceForm from '../components/PriceForm.astro';
---
<BaseLayout title="价格获取 | 深洋远瞰" description="提交货物类型、起运地、目的地、重量体积和运输方式，获取跨境物流价格方案。">
  <section class="mx-auto grid max-w-7xl gap-8 px-5 py-14 md:grid-cols-[.9fr_1.1fr]">
    <div><p class="text-cyan">Pricing</p><h1 class="mt-3 text-4xl font-bold">获取跨境物流价格</h1><p class="mt-5 leading-8 text-slate-300">支持海运、空运、快递及其他渠道询价。提交需求后，可根据货物信息、目的国与服务范围进行后续对接。</p><div class="mt-8 grid gap-4">{['提交需求','需求核对','匹配渠道','反馈报价'].map((item, i) => <div class="rounded-2xl border border-line bg-panel/70 p-5"><span class="text-cyan">0{i+1}</span><strong class="ml-3">{item}</strong></div>)}</div></div>
    <PriceForm />
  </section>
  <section class="mx-auto max-w-7xl px-5 pb-14"><h2 class="text-2xl font-bold">常见问题</h2><div class="mt-5 grid gap-4 md:grid-cols-3">{['需要哪些信息？','多久能反馈？','支持哪些运输方式？'].map((q) => <div class="rounded-2xl border border-line bg-panel/70 p-5"><h3 class="font-bold">{q}</h3><p class="mt-2 text-sm leading-7 text-muted">请尽量提供完整货物、路线和时效要求，便于评估方案。</p></div>)}</div></section>
</BaseLayout>
