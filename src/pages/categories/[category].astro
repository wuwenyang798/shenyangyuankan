---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getAllArticles } from '../../utils/getAllArticles';
const all = await getAllArticles();
export async function getStaticPaths() {
  const articles = await getAllArticles();
  const cats = Array.from(new Set(articles.map((a) => a.data.category)));
  return cats.map((category) => ({ params: { category }, props: { category } }));
}
const { category } = Astro.props;
const articles = all.filter((article) => article.data.category === category);
---
<BaseLayout title={`${category} 分类 | 深洋远瞰`} description={`查看深洋远瞰 ${category} 分类下的全部文章。`}>
  <section class="mx-auto max-w-7xl px-5 py-14"><p class="text-cyan">Category</p><h1 class="mt-3 text-4xl font-bold">{category}</h1>{articles.length ? <div class="mt-8 grid gap-5 md:grid-cols-3">{articles.map((article) => <ArticleCard article={article} />)}</div> : <p class="mt-8 text-muted">该分类暂无文章。</p>}</section>
</BaseLayout>
