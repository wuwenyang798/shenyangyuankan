---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getAllArticles, getAllTags } from '../../utils/getAllArticles';
const all = await getAllArticles();
export async function getStaticPaths() {
  const articles = await getAllArticles();
  return getAllTags(articles).map((tag) => ({ params: { tag }, props: { tag } }));
}
const { tag } = Astro.props;
const articles = all.filter((article) => article.data.tags.includes(tag));
---
<BaseLayout title={`#${tag} 标签 | 深洋远瞰`} description={`查看深洋远瞰标签 ${tag} 下的全部文章。`}>
  <section class="mx-auto max-w-7xl px-5 py-14"><p class="text-cyan">Tag</p><h1 class="mt-3 text-4xl font-bold">#{tag}</h1><div class="mt-8 grid gap-5 md:grid-cols-3">{articles.map((article) => <ArticleCard article={article} />)}</div></section>
</BaseLayout>
